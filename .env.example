# Copy to .env and fill in. See docs/ai-log.md for how grok-4-fast was chosen
# (resolves to xAI's current fast-tier model; ~15-20s for the full four-stage
# pipeline vs 60-100s+ with a larger model, with no observed quality loss in
# testing). Any valid xAI model id works; all four stages can use the same
# model or be set independently.
Llm__ApiKey=
Llm__Models__QueryGeneration=grok-4-fast
Llm__Models__QueryVerification=grok-4-fast
Llm__Models__ResultSummary=grok-4-fast
Llm__Models__ResultVerification=grok-4-fast
